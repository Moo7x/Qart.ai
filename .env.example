# Copy this file to .env for local dev, or add these as Replit Secrets.
# Never commit your real .env file. Names only: no real values here.
PROJECT_NAME="Qart.ai"

# LLM provider (OpenAI-compatible): CV extraction, explanations, research agent, on-screen agent
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Database: Replit Postgres URL (when set, the app uses Postgres) ...
DATABASE_URL=
# ... otherwise the SQLite file path (defaults to data/qart.sqlite)
QART_DB_PATH=

# Admin token for "Run pipeline now" and admin overrides (any long random string)
QART_ADMIN_TOKEN=

# RunPod (GPU embeddings endpoint, optional; leave blank to use BM25 search)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
