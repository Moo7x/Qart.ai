# Copy this file to .env for local dev, or add these as Replit Secrets.
# Never commit your real .env file. Names only: no real values here.
PROJECT_NAME="Qart.ai"

# LLM provider (OpenAI-compatible), used by the companion
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Web build: "false" makes the web app call the real API instead of sample data
VITE_USE_MOCKS=false

# Database: Replit Postgres URL (when set, src/store.py uses Postgres) ...
DATABASE_URL=
# ... otherwise the SQLite file path (defaults to data/qart.sqlite)
QART_DB_PATH=

# RunPod (GPU endpoint, optional; leave blank to use CPU retrieval)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Optional: a stronger model for the playbook optimiser's revisions (default: LLM_MODEL)
OPTIMIZER_MODEL=
