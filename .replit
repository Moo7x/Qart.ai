modules = ["python-3.12", "nodejs-22"]
run = "bash replit_start.sh"
entrypoint = "src/app.py"

[nix]
channel = "stable-24_05"
packages = ["glibcLocales", "libxcrypt", "libyaml", "postgresql"]

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
build = ["sh", "-c", "bash replit_build.sh"]
run = ["sh", "-c", "bash replit_serve.sh"]
deploymentTarget = "cloudrun"

[env]
PORT = "8000"
